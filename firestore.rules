rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function activeCoach() {
      return emailVerified()
        && profile(request.auth.uid).role == 'coach'
        && profile(request.auth.uid).status == 'active';
    }

    function activeAthlete(uid) {
      return emailVerified()
        && request.auth.uid == uid
        && profile(uid).role == 'athlete'
        && profile(uid).status == 'active'
        && profile(uid).onboardingComplete == true;
    }

    function coachOf(uid) {
      return activeCoach()
        && profile(uid).role == 'athlete'
        && profile(uid).trainerId == request.auth.uid;
    }

    function canReadAthlete(uid) {
      return activeAthlete(uid) || coachOf(uid);
    }

    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || coachOf(uid));
      allow list: if activeCoach()
        && resource.data.role == 'athlete'
        && resource.data.trainerId == request.auth.uid;
      allow create, delete: if false;
      allow update: if activeAthlete(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'displayName', 'preferences', 'updatedAt'
        ]);

      match /program/{programId} {
        allow read: if canReadAthlete(uid);
        allow write: if false;
      }

      match /programVersions/{versionId} {
        allow read: if canReadAthlete(uid);
        allow write: if false;
      }

      match /state/{recordId} {
        allow read: if canReadAthlete(uid);
        allow create: if activeAthlete(uid)
          && request.resource.data.uid == uid
          && request.resource.data.revision == 1
          && request.resource.data.snapshot is map
          && request.resource.data.updatedAt == request.time;
        allow update: if activeAthlete(uid)
          && request.resource.data.uid == uid
          && resource.data.uid == uid
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.snapshot is map
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if canReadAthlete(uid);
        allow create: if canReadAthlete(uid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.targetUid == uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.channel in ['thread', 'diary', 'deferred']
          && request.resource.data.createdAt == request.time;
        allow update: if canReadAthlete(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow delete: if false;
      }
    }

    match /coaches/{coachUid}/drafts/{draftId} {
      allow read: if activeCoach() && request.auth.uid == coachUid;
      allow write: if false;
    }

    match /adminOperations/{operationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
