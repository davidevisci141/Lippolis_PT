{
  "name": "lippolis-pt",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "apk": "CREA_APK.bat",
    "emulators": "firebase emulators:start --project demo-lippolis-pt --config firebase.json",
    "test": "npm run test:unit",
    "test:unit": "node --test test/functions.unit.test.cjs",
    "test:emulators": "firebase emulators:exec --project demo-lippolis-pt --only auth,firestore,functions --config firebase.json \"npm --prefix functions run test:emulators\"",
    "firebase:promote-coach": "node scripts/promote-coach.cjs",
    "firebase:link-client": "node scripts/link-client.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "timer-recupero": "file:./plugin-timer"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "firebase-tools": "^15.35.0"
  }
}
